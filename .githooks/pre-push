#!/bin/sh
# Typecheck and test the packages that this branch changes, before it leaves (FRU-172).
#
# « Changes » is against `main` of the remote, not against the last push: a push that skipped this
# hook must not hide its commits from the next one. Nx replays from its cache what did not change
# since the last run, so a second push of the same tree takes seconds.
#
# It runs the files of the working tree. So it checks a ref only when that ref is what is checked
# out, and what is not committed is part of what it checks. `git push --no-verify` skips it: CI is
# the gate, and this only says it sooner.
set -eu

cd "$(git rev-parse --show-toplevel)"
remote=$1

if [ ! -x node_modules/.bin/nx ]; then
  echo "pre-push: nx is not installed in this worktree." >&2
  echo "pre-push: run pnpm install, or push with --no-verify." >&2
  exit 1
fi

head=$(git rev-parse HEAD)
checked=0
while read -r local_ref local_sha _remote_ref _remote_sha; do
  # A deletion pushes a name made of zeros, and nothing to check.
  case $local_sha in *[!0]*) ;; *) continue ;; esac
  if [ "$local_sha" = "$head" ]; then
    checked=1
  else
    echo "pre-push: $local_ref is not what is checked out here, so it is not checked." >&2
  fi
done
[ "$checked" -eq 1 ] || exit 0

# One daemon of Nx for each worktree is one process too many on a machine that holds ten of them.
export NX_DAEMON=false

# Two typechecks at a time, then one package of tests at a time. `node --test` already runs the
# files of a package side by side, on every core but one, and `NODE_OPTIONS` refuses
# `--test-concurrency` (measured): the number of packages is the bound this hook can set.
run() {
  node_modules/.bin/nx "$@" -t typecheck --parallel=2
  node_modules/.bin/nx "$@" -t test --parallel=1
}

if ! base=$(git merge-base HEAD "refs/remotes/$remote/main" 2>/dev/null); then
  echo "pre-push: $remote/main is not known here, so every package is checked." >&2
  run run-many
  exit 0
fi

run affected --base="$base" --head=HEAD

# A file that no package owns is read by the guard tests of the worker: the documents, the
# workflows, the specs. Nx counts a project as affected by its own files only.
if git diff --name-only "$base" HEAD | grep -qv -e '^apps/' -e '^packages/'; then
  node_modules/.bin/nx run-many -t typecheck test -p @fruitback/worker --parallel=1
fi
