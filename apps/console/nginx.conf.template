# The console's server. At build time `csp.mjs` writes the hashes of the inline scripts; when the
# container starts, nginx writes FRUITBACK_API.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    # The access token lives in the page's memory. A policy that runs no other script, and lets the
    # page call one worker, is what keeps an injected script from reaching it.
    set $csp "default-src 'self'; script-src 'self' __SCRIPT_HASHES__; style-src 'self' 'unsafe-inline'; connect-src 'self' ${FRUITBACK_API}; img-src 'self' data:; frame-ancestors 'none'; base-uri 'none'; form-action 'self'";

    # The widget's script is embedded by sites: any page may load it.
    location = /fruitback.iife.js {
        add_header Access-Control-Allow-Origin * always;
        add_header Cache-Control "public, max-age=300" always;
        add_header X-Content-Type-Options nosniff always;
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options nosniff always;
    }

    # A single-page application: every other path is the same page, and it picks the screen.
    location / {
        try_files $uri /index.html;
        add_header Content-Security-Policy $csp always;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
    }
}
