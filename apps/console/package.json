{
  "name": "@fruitback/console",
  "version": "0.5.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "lint": "oxlint .",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "node --test ${FRUITBACK_TEST_CONCURRENCY:+--test-concurrency=$FRUITBACK_TEST_CONCURRENCY} 'app/**/*.test.ts'"
  },
  "dependencies": {
    "@fruitback/shared": "workspace:*",
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "3.2.6",
    "isbot": "^5.2.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "8.5.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@react-router/dev": "8.5.0",
    "@react-router/serve": "8.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "catalog:",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "catalog:",
    "vite": "^8.3.5"
  },
  "nx": {
    "targets": {
      "test": {
        "inputs": [
          "default",
          "^production",
          "{workspaceRoot}/packages/widget/src/typography.ts"
        ]
      }
    }
  }
}
