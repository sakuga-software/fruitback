{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fruitback-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },

  // `LINEAR_API_KEY` is a secret and is deliberately absent here — the whole reason this Worker
  // exists is that the token cannot live in client-side JS. Set it with:
  //   pnpm --filter @fruitback/worker exec wrangler secret put LINEAR_API_KEY
  "vars": {
    // Comma-separated list of client site origins allowed to post feedback. `*` allows any origin,
    // which is fine for a preview deploy and wrong for production.
    "ALLOWED_ORIGINS": "http://localhost:5173",
    "LINEAR_TEAM_ID": "d2e5bf16-7c31-4b8b-b45a-bedc845b1517",
    // Fruitback's own Linear project. Per-client routing lands with SKG-504.
    "LINEAR_PROJECT_ID": "f984149d-9ecc-4e30-b04c-b8d0d8bea267",
  },

  // Cloudflare's Rate Limiting API. `period` only accepts 10 or 60. The Worker falls back to an
  // isolate-local window when this binding is missing, so `wrangler dev` and tests still work.
  "ratelimits": [
    {
      "name": "FEEDBACK_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 },
    },
  ],
}
