{
  "name": "@fruitback/worker",
  "version": "0.3.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/main.ts",
    "start": "node dist/server.mjs",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node26 --outfile=dist/server.mjs --banner:js=\"import { createRequire as createRequireOfBundle } from 'node:module'; const require = createRequireOfBundle(import.meta.url);\"",
    "format": "oxfmt --check . '!drizzle/**'",
    "format:fix": "oxfmt . '!drizzle/**'",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:postgres": "FRUITBACK_TEST_POSTGRES=required vitest run src/postgres.test.ts src/postgres-outage.test.ts src/postgres-copy.test.ts src/postgres-copy-notes.test.ts src/postgres-adopt.test.ts src/postgres-numbers.test.ts src/postgres-own-schema.test.ts src/notes-postgres.test.ts src/store-conformance.test.ts src/account-conformance.test.ts src/accounts-postgres.test.ts src/session-conformance.test.ts src/session-postgres.test.ts src/auth.test.ts src/auth-schema.test.ts src/auth-instance.test.ts src/auth-at-rest.test.ts src/accounts-move.test.ts src/auth-routes.test.ts src/auth-organization.test.ts src/auth-rate-limit.test.ts src/attachments.test.ts src/kv.test.ts src/kv-postgres.test.ts src/sign-up.test.ts src/instance-admin-postgres.test.ts src/suspension.test.ts src/note-index-confirmed-migration.test.ts src/workspace-keeps-owner.test.ts src/sites-writers-migration.test.ts src/site-statuses-migration.test.ts src/site-statuses-store.test.ts",
    "dev:pglite": "node --watch src/dev-worker.fixture.ts",
    "serve:pglite": "node src/dev-worker.fixture.ts"
  },
  "dependencies": {
    "@fruitback/shared": "workspace:*",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "pg": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@electric-sql/pglite": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-kit": "catalog:",
    "esbuild": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  },
  "nx": {
    "targets": {
      "test": {
        "inputs": [
          "default",
          "^production",
          "{workspaceRoot}/**/*.md",
          "{workspaceRoot}/docs/**/*",
          "{workspaceRoot}/**/*.test.ts",
          "{workspaceRoot}/**/*.spec.ts",
          "{workspaceRoot}/**/*.test.*",
          "{workspaceRoot}/**/*.spec.*",
          "{workspaceRoot}/playwright.config.ts",
          "{workspaceRoot}/**/*.fixture.ts",
          "{workspaceRoot}/e2e/**/*.ts",
          "{workspaceRoot}/nx.json",
          "{workspaceRoot}/package.json",
          "{workspaceRoot}/pnpm-workspace.yaml",
          "{workspaceRoot}/apps/*/package.json",
          "{workspaceRoot}/packages/*/package.json",
          "{workspaceRoot}/.nvmrc",
          "{workspaceRoot}/.env.example",
          "{workspaceRoot}/docker-compose.yml",
          "{workspaceRoot}/.github/**/*",
          "{workspaceRoot}/.githooks/**/*",
          "{workspaceRoot}/.oxfmtignore",
          "{workspaceRoot}/tools/mutation-study/*.ts",
          "{workspaceRoot}/tools/mutation/*.ts",
          "{workspaceRoot}/tools/mutation/baseline.json",
          "{workspaceRoot}/tools/ci/*.ts",
          "{workspaceRoot}/tools/mutation/package.json",
          "{workspaceRoot}/apps/playground/vite.config.ts",
          "{workspaceRoot}/apps/playground/demo/**/*",
          "{workspaceRoot}/packages/widget/src/embed.ts",
          "{workspaceRoot}/apps/extension/src/session.ts",
          "{workspaceRoot}/apps/extension/src/endpoint.ts",
          "{workspaceRoot}/apps/**/*.ts",
          "{workspaceRoot}/apps/**/*.tsx",
          "{workspaceRoot}/apps/**/*.mjs",
          "{workspaceRoot}/apps/**/*.js",
          "{workspaceRoot}/packages/**/*.ts",
          "{workspaceRoot}/packages/**/*.tsx",
          "{workspaceRoot}/packages/**/*.mjs",
          "{workspaceRoot}/packages/**/*.js",
          "{workspaceRoot}/tools/**/*.ts"
        ]
      }
    }
  }
}
