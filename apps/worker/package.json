{
  "name": "@fruitback/worker",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/main.ts",
    "start": "node dist/server.mjs",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node26 --outfile=dist/server.mjs",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'src/**/*.test.ts'",
    "test:watch": "node --test --watch 'src/**/*.test.ts'",
    "dev:fake": "FRUITBACK_STORE=memory PORT=8788 ALLOWED_ORIGINS=http://localhost:5177 node --watch src/main.ts",
    "serve:fake": "FRUITBACK_STORE=memory PORT=8788 node src/main.ts"
  },
  "dependencies": {
    "@fruitback/shared": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "yaml": "catalog:"
  }
}
