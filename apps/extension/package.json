{
  "name": "@fruitback/extension",
  "version": "0.4.0",
  "private": true,
  "description": "Fruitback as a browser extension: review any site without it embedding anything.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "icons:build": "node build-icons.ts",
    "build:firefox": "wxt build -b firefox",
    "build:safari": "wxt build -b safari",
    "safari:xcode": "node safari-xcode.ts",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "lint": "oxlint .",
    "postinstall": "wxt prepare",
    "test": "node --test ${FRUITBACK_TEST_CONCURRENCY:+--test-concurrency=$FRUITBACK_TEST_CONCURRENCY} 'src/**/*.test.ts'",
    "typecheck": "wxt prepare && tsc --noEmit"
  },
  "dependencies": {
    "@fruitback/shared": "workspace:*",
    "@fruitback/widget": "workspace:*"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "catalog:",
    "happy-dom": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "wxt": "^0.21.4"
  },
  "nx": {
    "targets": {
      "test": {
        "inputs": [
          "default",
          "^production",
          "{workspaceRoot}/apps/console/app/app.css",
          "{workspaceRoot}/docs/install.md",
          "{workspaceRoot}/docs/reviewing.md",
          "{workspaceRoot}/docs/privacy.md",
          "{workspaceRoot}/SECURITY.md",
          "{workspaceRoot}/apps/worker/LICENSE",
          "{workspaceRoot}/apps/worker/src/app.ts",
          "{workspaceRoot}/apps/worker/src/pair-page.ts",
          "{workspaceRoot}/apps/worker/src/session.ts"
        ]
      }
    }
  }
}
