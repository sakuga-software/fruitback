{
  "name": "@fruitback/extension",
  "version": "0.1.0",
  "private": true,
  "description": "Fruitback as a browser extension: review any site without it embedding anything.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "lint": "oxlint .",
    "postinstall": "wxt prepare",
    "test": "node --test 'src/**/*.test.ts'",
    "typecheck": "wxt prepare && tsc --noEmit"
  },
  "dependencies": {
    "@fruitback/shared": "workspace:*",
    "@fruitback/widget": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "wxt": "^0.21.4"
  },
  "nx": {
    "targets": {
      "test": {
        "inputs": [
          "default",
          "^production",
          "{workspaceRoot}/docs/install.md",
          "{workspaceRoot}/docs/reviewing.md"
        ]
      }
    }
  }
}
