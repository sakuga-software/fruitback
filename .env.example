# The variables docker-compose.yml reads, and only those. Copy this file to .env beside it.
# A variable exported in your shell wins over this file.
# On Dokploy, set the same variables in the application's environment instead.

# ── The image and the port ───────────────────────────────────────────────────

# The image, as a complete reference. `edge` follows main. After the first release, choose a version
# (ghcr.io/sakuga-software/fruitback-worker:1.4.2). No tag is immutable: to pin, use a digest
# (ghcr.io/sakuga-software/fruitback-worker@sha256:…).
# Compose does not pull a tag that is already on the machine: run `docker compose pull` to update.
FRUITBACK_IMAGE=ghcr.io/sakuga-software/fruitback-worker:edge

# The port on the host. The container always listens on 8080.
# Behind a proxy on the same host, write 127.0.0.1:8080 so that the port answers only on the loopback.
# Before FRU-48 this variable was PORT. An old .env with PORT=9000 is ignored: rename it.
FRUITBACK_PORT=8080

# ── Who may call the worker ──────────────────────────────────────────────────

# The client sites that may post feedback, comma-separated. `*` allows any origin: good for a preview,
# wrong in production.
ALLOWED_ORIGINS=https://staging.example.com

# The number of reverse proxies between the internet and the container.
# 0 when the port is published directly, which is what docker-compose.yml does.
# 1 behind one Traefik. If the value is too high behind a proxy that appends to the header, such as nginx with
# $proxy_add_x_forwarded_for, a caller forges its address and escapes the rate limit. Behind Traefik or Caddy,
# a value that is too high puts every caller in one bucket. See docs/self-hosting.md.
# An .env from before FRU-48 says 1. If nothing is in front of the container, change it to 0.
TRUSTED_PROXY_HOPS=0

# Requests per minute per client address, reads and writes together. Empty means 20.
# The limit lives inside the container, so run one container: two containers are two limits.
RATE_LIMIT_PER_MINUTE=

# ── Where the seeds live ─────────────────────────────────────────────────────

# `sqlite` (the default here) keeps the seeds in one file on the volume, with no account anywhere.
# `linear` puts them in a Linear team. To use Linear, set FRUITBACK_STORE=linear, then fill
# LINEAR_API_KEY and LINEAR_TEAM_ID below.
# `github` puts them in a GitHub repository. To use GitHub, set FRUITBACK_STORE=github, then fill the
# three FRUITBACK_GITHUB_ lines below.
# An .env from before FRU-48 has no FRUITBACK_STORE and ran on Linear. To keep Linear, add
# FRUITBACK_STORE=linear, or the worker starts on an empty SQLite file.
FRUITBACK_STORE=sqlite

# The SQLite file. It must be on the /data volume, or the seeds go when the container is recreated.
FRUITBACK_SQLITE_PATH=/data/fruitback.db

# A Linear personal API key. It is a secret: it must never reach a browser or the image.
LINEAR_API_KEY=

# The Linear team that receives the issues.
LINEAR_TEAM_ID=

# Optional: the Linear project for the issues. A client in FRUITBACK_CLIENTS can override it.
LINEAR_PROJECT_ID=

# The ID of the GitHub App, or its client ID, from the App's settings page.
# docs/self-hosting.md says how to create the App and which permissions it needs.
FRUITBACK_GITHUB_APP_ID=

# The App's private key: the .pem file GitHub generates. It is a secret.
# Write it on one line with each line break written as \n, or keep its line breaks inside double quotes.
FRUITBACK_GITHUB_PRIVATE_KEY=

# The repository that receives the issues, as owner/repo. The App must be installed on it.
# A client in FRUITBACK_CLIENTS can override it with its own `repository`.
FRUITBACK_GITHUB_REPOSITORY=

# ── Several client sites ─────────────────────────────────────────────────────

# JSON: clientId → { teamId?, projectId?, repository?, origins?, identitySecret?, showComments?, read? }.
# Empty means one client. When it is set, a read and a write must each name a known client, and an
# unknown client is refused. `origins` joins ALLOWED_ORIGINS for that client.
# Example: FRUITBACK_CLIENTS='{"acme":{"teamId":"team_1","origins":["https://acme.test"]}}'
FRUITBACK_CLIENTS=

# ── Identity and reads ───────────────────────────────────────────────────────

# Shared with a client site so that it can sign identity tokens (HS256, 32 characters minimum).
# Empty means every reporter is self-declared. A worker with FRUITBACK_CLIENTS ignores this key:
# each client declares its own identitySecret.
# WARNING: with accounts (FRUITBACK_ACCOUNTS_PATH or FRUITBACK_DATABASE_URL) no site needs this key,
# and whoever holds it opens the console of every account. Give it to no site there. If a site ever
# had it, change it: see « Change FRUITBACK_IDENTITY_SECRET » in docs/self-hosting.md.
FRUITBACK_IDENTITY_SECRET=

# Who may read pins: `public` (empty means public) or `authenticated`.
# `public` answers anyone who can build the URL, with the notes, their authors and the team's replies.
# `authenticated` needs FRUITBACK_IDENTITY_SECRET, and the worker refuses to start without it.
FRUITBACK_READ=

# `1` keeps the team's Linear replies out of the pins. Empty shows them.
FRUITBACK_HIDE_COMMENTS=

# The language of the prose in an issue description, for the team that triages it: `en` or `fr`.
# Empty means English. It never follows the reporter's browser: a note written in Tokyo must not
# file a Japanese issue into a team that reads English. The note itself is never translated.
FRUITBACK_TEAM_LOCALE=

# ── The browser extension's sessions ─────────────────────────────────────────

# Empty turns the /session endpoints off. To turn them on, use a file on the /data volume, for example
# /data/sessions.db, and set FRUITBACK_IDENTITY_SECRET. The worker refuses to start if this is set
# without FRUITBACK_IDENTITY_SECRET, or with a FRUITBACK_CLIENTS in which no client declares a workspace.
# Back it up like the seeds:
#   docker compose exec worker sqlite3 /data/sessions.db ".backup '/data/sessions-backup.db'"
# Mint a pairing code with:
#   docker compose exec worker node server.mjs pair --subject alice --name "Alice Martin"
FRUITBACK_SESSION_PATH=

# The accounts, the workspaces and their sites, for the console (FRU-96). Set, the sites come from
# this file and FRUITBACK_CLIENTS must be empty. It needs FRUITBACK_SESSION_PATH. Example: /data/accounts.db
FRUITBACK_ACCOUNTS_PATH=

# The same accounts in a PostgreSQL database, in place of that file (FRU-141), and the sessions with
# them (FRU-142). Set, FRUITBACK_ACCOUNTS_PATH and FRUITBACK_SESSION_PATH must both be empty: the
# worker refuses to start beside either. `pair` then writes its code in the database.
# This value holds a password. Example: postgres://fruitback:<password>@postgres:5432/fruitback
FRUITBACK_DATABASE_URL=

# The password of the PostgreSQL of docker-compose.yml (FRU-143): its `postgres` service, which starts
# only with `docker compose --profile postgres up`. Empty, that service refuses to make its database.
# The worker does not read this variable: write the same password in FRUITBACK_DATABASE_URL.
FRUITBACK_POSTGRES_PASSWORD=

# Where the console answers, for example https://app.fruitback.com. Required with FRUITBACK_ACCOUNTS_PATH:
# a sign-in link opens it, and the console routes answer this origin and no other.
FRUITBACK_CONSOLE_URL=

# Sign-in by a link sent by e-mail, through Scaleway Transactional Email. Both or neither.
# FRUITBACK_MAIL_FROM is an address on a domain Scaleway verified. FRUITBACK_SCALEWAY_TEM is
# <project id>:<secret key> of an API key that may send. Keep it secret.
FRUITBACK_MAIL_FROM=
FRUITBACK_SCALEWAY_TEM=

# Sign-in with GitHub. FRUITBACK_PUBLIC_URL is the address this worker answers at, for example
# https://api.fruitback.com: GitHub sends the person back to <it>/auth/github/callback, which must be the
# callback of the OAuth App. FRUITBACK_GITHUB_OAUTH is <client id>:<client secret>. Keep it secret.
FRUITBACK_PUBLIC_URL=
FRUITBACK_GITHUB_OAUTH=

# Sign-in with Google. FRUITBACK_GOOGLE_OAUTH is <client id>:<client secret> of an OAuth client of
# type « Web application », whose redirect URI is <FRUITBACK_PUBLIC_URL>/auth/google/callback.
# Keep it secret.
FRUITBACK_GOOGLE_OAUTH=

# A workspace connects its Linear with no personal key. FRUITBACK_LINEAR_OAUTH is
# <client id>:<client secret> of a Linear OAuth application, whose callback is
# <FRUITBACK_PUBLIC_URL>/auth/linear/callback. It needs FRUITBACK_SECRETS_KEY too. Keep it secret.
FRUITBACK_LINEAR_OAUTH=

# What encrypts the keys of the connectors a workspace adds (its Linear API key). At least 32
# characters, and not FRUITBACK_IDENTITY_SECRET. Keep it: without it every connector is lost.
FRUITBACK_SECRETS_KEY=

# What better-auth signs the session cookie of the console with (FRU-144). Empty: better-auth is off
# and nothing of it is loaded. Set, it needs FRUITBACK_DATABASE_URL and FRUITBACK_PUBLIC_URL, and the
# worker builds better-auth when it starts and serves its sign-in under /console/auth (FRU-147),
# beside the sign-in of before. At least 32 random characters, and not one of the two secrets above.
# Keep it secret, and out of every backup. Generate one with: openssl rand -base64 32
FRUITBACK_AUTH_SECRET=

# Sign-in with GitHub through better-auth (FRU-147): a second GitHub OAuth App, beside the one of
# FRUITBACK_GITHUB_OAUTH, because an App has one callback. Its callback is
# <FRUITBACK_PUBLIC_URL>/console/auth/callback/github. <client id>:<client secret>. Keep it secret.
# Google needs no second client: add <FRUITBACK_PUBLIC_URL>/console/auth/callback/google to the one
# of FRUITBACK_GOOGLE_OAUTH.
FRUITBACK_AUTH_GITHUB_OAUTH=

# 1: better-auth keeps the address and the user agent of each session of the console, and limits by
# address too. Empty: it keeps neither (docs/privacy.md).
FRUITBACK_AUTH_TRACK_IP=
