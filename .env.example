# The variables docker-compose.yml reads, and only those. Copy this file to .env beside it.
# A variable exported in your shell wins over this file.
# On Dokploy, set the same variables in the application's environment instead.

# ── The image and the port ───────────────────────────────────────────────────

# The image, as a complete reference. `edge` follows main. After the first release, choose a version
# (ghcr.io/sakuga-software/fruitback-worker:1.4.2). No tag is immutable: to pin, use a digest
# (ghcr.io/sakuga-software/fruitback-worker@sha256:…).
# Compose does not pull a tag that is already on the machine: run `docker compose pull` to update.
FRUITBACK_IMAGE=ghcr.io/sakuga-software/fruitback-worker:edge

# The port on the host. The container always listens on 8080.
# Behind a proxy on the same host, write 127.0.0.1:8080 so that the port answers only on the loopback.
# Before SKG-541 this variable was PORT. An old .env with PORT=9000 is ignored: rename it.
FRUITBACK_PORT=8080

# ── Who may call the worker ──────────────────────────────────────────────────

# The client sites that may post feedback, comma-separated. `*` allows any origin: good for a preview,
# wrong in production.
ALLOWED_ORIGINS=https://staging.example.com

# The number of reverse proxies between the internet and the container.
# 0 when the port is published directly, which is what docker-compose.yml does.
# 1 behind one Traefik. If the value is too high behind a proxy that appends to the header, such as nginx with
# $proxy_add_x_forwarded_for, a caller forges its address and escapes the rate limit. Behind Traefik or Caddy,
# a value that is too high puts every caller in one bucket. See docs/self-hosting.md.
# An .env from before SKG-541 says 1. If nothing is in front of the container, change it to 0.
TRUSTED_PROXY_HOPS=0

# Requests per minute per client address, reads and writes together. Empty means 20.
# The limit lives inside the container, so run one container: two containers are two limits.
RATE_LIMIT_PER_MINUTE=

# ── Where the seeds live ─────────────────────────────────────────────────────

# `sqlite` (the default here) keeps the seeds in one file on the volume, with no account anywhere.
# `linear` puts them in a Linear team. To use Linear, set FRUITBACK_STORE=linear, then fill
# LINEAR_API_KEY and LINEAR_TEAM_ID below.
# An .env from before SKG-541 has no FRUITBACK_STORE and ran on Linear. To keep Linear, add
# FRUITBACK_STORE=linear, or the worker starts on an empty SQLite file.
FRUITBACK_STORE=sqlite

# The SQLite file. It must be on the /data volume, or the seeds go when the container is recreated.
FRUITBACK_SQLITE_PATH=/data/fruitback.db

# A Linear personal API key. It is a secret: it must never reach a browser or the image.
LINEAR_API_KEY=

# The Linear team that receives the issues.
LINEAR_TEAM_ID=

# Optional: the Linear project for the issues. A client in FRUITBACK_CLIENTS can override it.
LINEAR_PROJECT_ID=

# ── Several client sites ─────────────────────────────────────────────────────

# JSON: clientId → { teamId?, projectId?, origins?, identitySecret?, showComments?, read? }.
# Empty means one client. When it is set, a read and a write must each name a known client, and an
# unknown client is refused. `origins` joins ALLOWED_ORIGINS for that client.
# Example: FRUITBACK_CLIENTS='{"acme":{"teamId":"team_1","origins":["https://acme.test"]}}'
FRUITBACK_CLIENTS=

# ── Identity and reads ───────────────────────────────────────────────────────

# Shared with a client site so that it can sign identity tokens (HS256, 32 characters minimum).
# Empty means every reporter is self-declared. A worker with FRUITBACK_CLIENTS ignores this key:
# each client declares its own identitySecret.
FRUITBACK_IDENTITY_SECRET=

# Who may read pins: `public` (empty means public) or `authenticated`.
# `public` answers anyone who can build the URL, with the notes, their authors and the team's replies.
# `authenticated` needs FRUITBACK_IDENTITY_SECRET, and the worker refuses to start without it.
FRUITBACK_READ=

# `1` keeps the team's Linear replies out of the pins. Empty shows them.
FRUITBACK_HIDE_COMMENTS=

# ── The browser extension's sessions ─────────────────────────────────────────

# Empty turns the /session endpoints off. To turn them on, use a file on the /data volume, for example
# /data/sessions.db, and set FRUITBACK_IDENTITY_SECRET. The worker refuses to start if this is set with
# FRUITBACK_CLIENTS or without FRUITBACK_IDENTITY_SECRET.
# Back it up like the seeds:
#   docker compose exec worker sqlite3 /data/sessions.db ".backup '/data/sessions-backup.db'"
# Mint a pairing code with:
#   docker compose exec worker node server.mjs pair --subject alice --name "Alice Martin"
FRUITBACK_SESSION_PATH=
