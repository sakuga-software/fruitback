# The variables docker-compose.yml reads, and only those. Copy this file to .env beside it.
# A variable exported in your shell wins over this file.
# On Dokploy, set the same variables in the application's environment instead.
#
# Five lines to fill before the first `docker compose up -d --wait` (FRU-225): ALLOWED_ORIGINS,
# FRUITBACK_POSTGRES_PASSWORD, FRUITBACK_AUTH_SECRET, FRUITBACK_IDENTITY_SECRET and
# FRUITBACK_FIRST_ADMIN. Each secret says the command that makes it. The worker makes none: a secret it
# made would change at each start, or end in a backup. Missing ones are named in `docker compose logs worker`.

# ── The image and the port ───────────────────────────────────────────────────

# The image, as a complete reference. `edge` follows main. After the first release, choose a version
# (ghcr.io/sakuga-software/fruitback-worker:1.4.2). No tag is immutable: to pin, use a digest
# (ghcr.io/sakuga-software/fruitback-worker@sha256:…).
# Compose does not pull a tag that is already on the machine: run `docker compose pull` to update.
FRUITBACK_IMAGE=ghcr.io/sakuga-software/fruitback-worker:edge

# The port on the host. The container always listens on 8080.
# Behind a proxy on the same host, write 127.0.0.1:8080 so that the port answers only on the loopback.
# Before FRU-48 this variable was PORT. An old .env with PORT=9000 is ignored: rename it.
FRUITBACK_PORT=8080

# The image of the console (FRU-222), as a complete reference, and its port on the host. It reads one
# address, the one of the worker: FRUITBACK_PUBLIC_URL.
FRUITBACK_CONSOLE_IMAGE=ghcr.io/sakuga-software/fruitback-console:edge
FRUITBACK_CONSOLE_PORT=8081

# ── Who may call the worker ──────────────────────────────────────────────────

# The client sites that may post feedback, comma-separated. `*` allows any origin: good for a preview,
# wrong in production.
ALLOWED_ORIGINS=https://staging.example.com

# The number of reverse proxies between the internet and the container.
# 0 when the port is published directly, which is what docker-compose.yml does.
# 1 behind one Traefik. If the value is too high behind a proxy that appends to the header, such as nginx with
# $proxy_add_x_forwarded_for, a caller forges its address and escapes the rate limit. Behind Traefik or Caddy,
# a value that is too high puts every caller in one bucket. See docs/self-hosting.md.
# An .env from before FRU-48 says 1. If nothing is in front of the container, change it to 0.
TRUSTED_PROXY_HOPS=0

# Requests per minute per client address, reads and writes together. Empty means 20.
# The limit lives inside the container, so run one container: two containers are two limits.
RATE_LIMIT_PER_MINUTE=

# ── The database ─────────────────────────────────────────────────────────────

# The password of the PostgreSQL of docker-compose.yml (FRU-143). Required: the file refuses to start
# without it. The worker reaches that database with it, through the address docker-compose.yml makes.
# Make one with: openssl rand -hex 32   (hex: it goes into an address, where some characters cannot)
FRUITBACK_POSTGRES_PASSWORD=

# The address of the PostgreSQL the worker keeps everything in: its notes, its sites, its accounts and
# its sessions. Empty: the `postgres` service of docker-compose.yml. To use a database you already run,
# write its address, which holds a password. Example: postgres://fruitback:<password>@db.internal:5432/app
FRUITBACK_DATABASE_URL=

# The schema of that database for the tables of the worker and its journal of migrations (FRU-219).
# Empty means `public`: right for a database that is the worker's own. In a database that another
# application uses too, name a schema, `fruitback` for example: the worker makes it when it is not
# there, and writes nowhere else. A lower-case letter or `_`, then lower-case letters, digits and `_`,
# and not a key word of SQL (`user`, `order`, `table`…).
FRUITBACK_DATABASE_SCHEMA=

# ── The console and its first administrator ─────────────────────────────────

# The address this worker answers at, as a browser reaches it, with no path: the console calls it from
# the browser, and a sign-in comes back to it. Never the name of the service. Behind a proxy, for
# example https://api.feedback.example.com.
FRUITBACK_PUBLIC_URL=http://localhost:8080

# Where the console answers, as a browser reaches it: a sign-in link opens it, and the console routes
# answer this origin and no other. Behind a proxy, for example https://app.feedback.example.com.
FRUITBACK_CONSOLE_URL=http://localhost:8081

# What better-auth signs the session cookie of the console with (FRU-144). Required. At least 32
# random characters, and not one of the two secrets below. Changing it ends every session of the
# console. Keep it secret, and out of every backup.
# Make one with: openssl rand -base64 32
FRUITBACK_AUTH_SECRET=

# What signs the access token of a session of the browser extension. Required. At least 32 random
# characters. No site needs it: give it to none. If a site ever had it, change it: see « Change
# FRUITBACK_IDENTITY_SECRET » in docs/self-hosting.md.
# Make one with: openssl rand -base64 32
FRUITBACK_IDENTITY_SECRET=

# The first administrator (FRU-221): the address of one person. A worker whose instance has no owner
# yet writes a sign-in link for that address in its log when it starts. Read it with
# `docker compose logs worker`, and open it: that person makes the first workspace and its first site.
# It needs no e-mail and no GitHub or Google sign-in.
# WARNING: the link is in the log in the clear, 10 minutes, usable once: whoever reads the log can
# sign in as that address and own the instance. Nothing is written once a workspace has an owner.
# With nothing in the log: docker compose exec worker node server.mjs admin-link --email <address>
FRUITBACK_FIRST_ADMIN=

# ── Where the notes go ───────────────────────────────────────────────────────

# `postgres` (the default) keeps the notes in the database above, beside the sites. A site can also
# send its notes to a tracker of its workspace, connected in the console.
# `linear` puts the notes of every site with no tracker of its own in one Linear team: set
# FRUITBACK_STORE=linear, then fill LINEAR_API_KEY and LINEAR_TEAM_ID below.
# `github` does the same with a GitHub repository: set FRUITBACK_STORE=github, then fill the three
# FRUITBACK_GITHUB_ lines below.
# `sqlite` is refused since FRU-225: « Upgrading » in docs/self-hosting.md copies its file.
FRUITBACK_STORE=postgres

# A Linear personal API key. It is a secret: it must never reach a browser or the image.
LINEAR_API_KEY=

# The Linear team that receives the issues.
LINEAR_TEAM_ID=

# Optional: the Linear project for the issues.
LINEAR_PROJECT_ID=

# The ID of the GitHub App, or its client ID, from the App's settings page.
# docs/self-hosting.md says how to create the App and which permissions it needs.
FRUITBACK_GITHUB_APP_ID=

# The App's private key: the .pem file GitHub generates. It is a secret.
# Write it on one line with each line break written as \n, or keep its line breaks inside double quotes.
FRUITBACK_GITHUB_PRIVATE_KEY=

# The repository that receives the issues, as owner/repo. The App must be installed on it.
FRUITBACK_GITHUB_REPOSITORY=

# ── Reads ────────────────────────────────────────────────────────────────────

# Who reads the pins of a site is chosen site by site, in the console: members of its workspace only,
# or everyone. This variable was the setting of a worker without a database, and it does not apply to
# a site of the console. Leave it empty.
FRUITBACK_READ=

# `1` keeps the team's Linear replies out of the pins. Empty shows them.
FRUITBACK_HIDE_COMMENTS=

# The language of the prose in an issue description, for the team that triages it: `en` or `fr`.
# Empty means English. It never follows the reporter's browser: a note written in Tokyo must not
# file a Japanese issue into a team that reads English. The note itself is never translated.
FRUITBACK_TEAM_LOCALE=

# ── Other ways to sign in to the console ─────────────────────────────────────

# Sign-in by a link sent by e-mail, through Scaleway Transactional Email. Both or neither.
# FRUITBACK_MAIL_FROM is an address on a domain Scaleway verified. FRUITBACK_SCALEWAY_TEM is
# <project id>:<secret key> of an API key that may send. Keep it secret.
FRUITBACK_MAIL_FROM=
FRUITBACK_SCALEWAY_TEM=

# Sign-in with Google, through better-auth. FRUITBACK_GOOGLE_OAUTH is <client id>:<client secret> of
# an OAuth client of type « Web application », whose redirect URI is
# <FRUITBACK_PUBLIC_URL>/console/auth/callback/google. It needs FRUITBACK_AUTH_SECRET. Keep it secret.
FRUITBACK_GOOGLE_OAUTH=

# A workspace connects its Linear with no personal key. FRUITBACK_LINEAR_OAUTH is
# <client id>:<client secret> of a Linear OAuth application, whose callback is
# <FRUITBACK_PUBLIC_URL>/auth/linear/callback. It needs FRUITBACK_SECRETS_KEY too. Keep it secret.
FRUITBACK_LINEAR_OAUTH=

# What encrypts the keys of the connectors a workspace adds (its Linear API key). At least 32
# characters, and not FRUITBACK_IDENTITY_SECRET. Keep it: without it every connector is lost.
FRUITBACK_SECRETS_KEY=

# Sign-in with GitHub through better-auth (FRU-147): a GitHub OAuth App whose callback is
# <FRUITBACK_PUBLIC_URL>/console/auth/callback/github. <client id>:<client secret>. Keep it secret.
FRUITBACK_AUTH_GITHUB_OAUTH=

# 1: better-auth keeps the address and the user agent of each session of the console, and limits by
# address too. Empty: it keeps neither (docs/privacy.md).
FRUITBACK_AUTH_TRACK_IP=

# ── Variables the worker no longer takes ─────────────────────────────────────

# Leave them empty. Set, the worker refuses to start and says what to do: docker-compose.yml hands them
# over for that reason only, so that an upgrade with a `.env` of before is never read as a worker that
# lost its data. « Upgrading » in docs/self-hosting.md says how to copy each file into the database.
# FRUITBACK_ACCOUNTS_PATH was the accounts file (FRU-150): the accounts are in the database.
# FRUITBACK_GITHUB_OAUTH was the GitHub App of the sign-in of before: FRUITBACK_AUTH_GITHUB_OAUTH.
# FRUITBACK_CLIENTS was the map of the sites (FRU-225): the console makes each site.
# FRUITBACK_SESSION_PATH was the file of the sessions: they are in the database, and a reviewer pairs again.
# FRUITBACK_SQLITE_PATH was the file of the notes: `migrate-to-postgres --seeds` copies it.
# FRUITBACK_FIRST_REVIEWER paired the first reviewer of a worker with no workspace: FRUITBACK_FIRST_ADMIN.
FRUITBACK_ACCOUNTS_PATH=
FRUITBACK_GITHUB_OAUTH=
FRUITBACK_CLIENTS=
FRUITBACK_SESSION_PATH=
FRUITBACK_SQLITE_PATH=
FRUITBACK_FIRST_REVIEWER=
