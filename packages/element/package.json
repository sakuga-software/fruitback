{
  "name": "@fruitback/element",
  "version": "0.1.0",
  "description": "The Fruitback widget as a custom element: <fruitback-widget endpoint client-id>.",
  "license": "MIT",
  "files": [
    "dist",
    "src",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "!src/**/*.test.ts"
  ],
  "type": "module",
  "sideEffects": [
    "./src/auto.ts",
    "./dist/auto.js",
    "./dist/fruitback-element.iife.js"
  ],
  "main": "src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./auto": "./src/auto.ts"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./auto": {
        "types": "./dist/auto.d.ts",
        "import": "./dist/auto.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "node build.ts",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "lint": "oxlint .",
    "prepack": "pnpm build",
    "test": "node --test 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@fruitback/widget": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "happy-dom": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  }
}
