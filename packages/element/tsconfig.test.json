{
  // The tests run on `node:test`, so they need Node types. The element itself must not.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"]
  },
  // `*.ts` is `build.ts`: it runs on Node too, and no other configuration reads it (FRU-173).
  "include": ["src/**/*", "*.ts"],
  "exclude": []
}
