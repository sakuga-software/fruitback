{
  "name": "@fruitback/shared",
  "version": "0.3.0",
  "description": "The Fruitback note contract — the payload the widget writes and the worker stores.",
  "homepage": "https://github.com/sakuga-software/fruitback#readme",
  "bugs": "https://github.com/sakuga-software/fruitback/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sakuga-software/fruitback.git",
    "directory": "packages/shared"
  },
  "files": [
    "dist",
    "src",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./note.fixture": "./src/note.fixture.ts",
    "./seed.fixture": "./src/seed.fixture.ts"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./note.fixture": {
        "types": "./dist/note.fixture.d.ts",
        "import": "./dist/note.fixture.js"
      },
      "./seed.fixture": {
        "types": "./dist/seed.fixture.d.ts",
        "import": "./dist/seed.fixture.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "node build.ts",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "lint": "oxlint .",
    "prepack": "pnpm build",
    "test": "node --test ${FRUITBACK_TEST_CONCURRENCY:+--test-concurrency=$FRUITBACK_TEST_CONCURRENCY} 'src/**/*.test.ts'",
    "test:watch": "node --test --watch 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  }
}
