{
  // The tests run on `node:test`, so they need Node types — but only they do. Keeping this apart is
  // what stops production code in this package from quietly depending on a Node API.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"]
  },
  // `*.ts` is `build.ts`: it runs on Node too, and no other configuration reads it (FRU-173).
  "include": ["src/**/*", "*.ts"],
  "exclude": []
}
