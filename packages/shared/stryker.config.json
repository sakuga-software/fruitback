{
  "$schema": "../../tools/mutation/node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "The seed contract, every file of it. docs/decisions/conventions.md says why each option is set (FRU-172).",
  "testRunner": "tap",
  "plugins": ["../../tools/mutation/node_modules/@stryker-mutator/tap-runner/dist/src/index.js"],
  "tap": { "testFiles": ["src/**/*.test.ts"] },
  "mutate": ["src/attachments.ts", "src/contrast.ts", "src/issue.ts", "src/markdown-description.ts", "src/seed.ts"],
  "inPlace": true,
  "coverageAnalysis": "perTest",
  "reporters": ["clear-text", "json", "html"],
  "thresholds": { "high": 80, "low": 60, "break": null }
}
