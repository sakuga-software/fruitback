{
  "name": "@fruitback/react",
  "version": "0.1.0",
  "description": "The Fruitback widget as a React component: <Fruitback endpoint clientId />.",
  "license": "MIT",
  "files": [
    "dist",
    "src",
    "LICENSE",
    "!src/**/*.test.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "node build.ts",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "lint": "oxlint .",
    "prepack": "pnpm build",
    "test": "node --test 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@fruitback/widget": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "happy-dom": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "react": ">=18"
  }
}
