{
  "name": "@fruitback/widget",
  "version": "0.1.0",
  "description": "Visual feedback widget: click an element, write a note, get a Linear issue.",
  "license": "UNLICENSED",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "main": "./dist/fruitback.mjs",
    "types": "./dist/public.d.ts",
    "exports": {
      ".": {
        "types": "./dist/public.d.ts",
        "import": "./dist/fruitback.mjs"
      },
      "./global": "./dist/fruitback.iife.js"
    },
    "access": "public"
  },
  "scripts": {
    "build": "node build.ts",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "lint": "oxlint .",
    "prepack": "pnpm build",
    "test": "node --test 'src/**/*.test.ts'",
    "test:watch": "node --test --watch 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@fruitback/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "happy-dom": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "react-grab": "catalog:",
    "typescript": "catalog:"
  }
}
