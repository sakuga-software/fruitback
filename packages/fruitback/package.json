{
  "name": "fruitback",
  "version": "0.3.0",
  "description": "Visual feedback widget: click an element, write a note, get a Linear issue.",
  "homepage": "https://github.com/sakuga-software/fruitback#readme",
  "bugs": "https://github.com/sakuga-software/fruitback/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sakuga-software/fruitback.git",
    "directory": "packages/fruitback"
  },
  "files": [
    "dist",
    "src",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "node build.ts",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "lint": "oxlint .",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@fruitback/shared": "workspace:*",
    "@fruitback/widget": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  }
}
